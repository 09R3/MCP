# ── Share / storage ──────────────────────────────────────────────────────────
# Host path to the SMB share (or any local directory) that will be bind-mounted
# as /data inside the container.  Change this to wherever your Unraid SMB share
# is exposed on the host filesystem.
SHARE_PATH=/mnt/user/Documents

# Maximum file size the server will process (in MB).  Larger files are rejected
# to prevent out-of-memory crashes inside the container.
MAX_FILE_SIZE_MB=100

# ── Transport ─────────────────────────────────────────────────────────────────
# "stdio"  – suitable for Claude Desktop (communicates over stdin/stdout).
# "sse"    – HTTP + Server-Sent Events endpoint; use for Ollama, LM Studio,
#             Open WebUI, or any OpenAI-compatible local LLM front-end.
TRANSPORT=sse

# Port exposed when TRANSPORT=sse
PORT=3000

# ── Resource limits ───────────────────────────────────────────────────────────
MEMORY_LIMIT=512m
